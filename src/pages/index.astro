---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroup from '../components/SkillGroup.astro';

import { site } from '../content/site';
import { experience } from '../content/experience';
import { projects } from '../content/projects';
import { skills } from '../content/skills';
---

<BaseLayout title={`${site.brand} · ${site.name}`} description={site.about}>
  <main class="page-shell">
    <Hero site={site} />

    <section id="about" class="content-section">
      <SectionHeading eyebrow="About" title="关于我" />
      <p class="body-copy">{site.about}</p>
    </section>

    <section id="experience" class="content-section">
      <SectionHeading eyebrow="Experience" title="教育与实习经历" description="把学历和实习放进同一条时间线里，方便直接看路径和节奏。" />
      <Timeline items={experience} />
    </section>

    <section id="projects" class="content-section">
      <SectionHeading eyebrow="Projects" title="项目作品" description="首页先放已上线项目，后续项目会直接接进同一套卡片结构。" />
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section id="skills" class="content-section">
      <SectionHeading eyebrow="Skills" title="个人技能" />
      <div class="skills-grid">
        {skills.map((group) => <SkillGroup group={group} />)}
      </div>
    </section>

    <section id="contact" class="content-section">
      <SectionHeading eyebrow="Contact" title="联系方式" />
      <a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a>
    </section>

    <dialog class="project-dialog" data-project-dialog aria-labelledby="project-dialog-title">
      <div class="project-dialog-shell">
        <button type="button" class="dialog-close" data-project-close aria-label="关闭项目详情">×</button>
        <p class="eyebrow" data-project-role>项目作品</p>
        <h2 id="project-dialog-title" data-project-title>项目名称</h2>
        <p class="project-dialog-period" data-project-period></p>
        <p class="project-dialog-summary" data-project-summary></p>

        <div class="project-dialog-grid">
          <section>
            <h3>详细介绍</h3>
            <p class="project-dialog-text" data-project-details></p>
          </section>

          <section>
            <h3>项目亮点</h3>
            <ul class="bullet-list project-dialog-highlights" data-project-highlights></ul>
          </section>
        </div>

        <div class="project-dialog-actions">
          <a class="contact-link project-dialog-link" data-project-url href="#" target="_blank" rel="noreferrer">访问项目</a>
        </div>
      </div>
    </dialog>
  </main>

  <script define:vars={{ projects }}>
    const dialog = document.querySelector('[data-project-dialog]');
    const title = document.querySelector('[data-project-title]');
    const role = document.querySelector('[data-project-role]');
    const period = document.querySelector('[data-project-period]');
    const summary = document.querySelector('[data-project-summary]');
    const details = document.querySelector('[data-project-details]');
    const highlights = document.querySelector('[data-project-highlights]');
    const url = document.querySelector('[data-project-url]');
    const closeButton = document.querySelector('[data-project-close]');

    const projectMap = new Map(projects.map((project) => [project.slug, project]));

    function fillProject(project) {
      if (!dialog || !title || !role || !period || !summary || !details || !highlights || !url) {
        return;
      }

      title.textContent = project.title;
      role.textContent = project.role;
      period.textContent = project.period;
      summary.textContent = project.summary;
      details.textContent = project.details;
      url.href = project.url;

      highlights.replaceChildren(
        ...project.highlights.map((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          return li;
        })
      );
    }

    document.querySelectorAll('[data-project-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const slug = trigger.getAttribute('data-project-slug');
        if (!slug || !(dialog instanceof HTMLDialogElement)) {
          return;
        }

        const project = projectMap.get(slug);
        if (!project) {
          return;
        }

        fillProject(project);
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) {
        dialog.close();
      }
    });

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) {
        dialog.close();
      }
    });
  </script>
</BaseLayout>
