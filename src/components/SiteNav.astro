---
const navItems = [
  { href: '#about', labelZh: '关于', labelEn: 'About' },
  { href: '#experience', labelZh: '经历', labelEn: 'Experience' },
  { href: '#projects', labelZh: '项目', labelEn: 'Projects' },
  { href: '#sops', labelZh: 'Workflow', labelEn: 'Workflow' },
  { href: '#skills', labelZh: '技能', labelEn: 'Skills' },
  { href: '#contact', labelZh: '联系', labelEn: 'Contact' }
] as const;
---

<header class="site-nav">
  <div class="site-nav-shell">
    <a class="site-nav-brand" href="#top" aria-label="返回顶部">SZY / PM</a>

    <nav class="site-nav-links" aria-label="页面分区">
      {navItems.map((item) => (
        <a href={item.href} data-label-zh={item.labelZh} data-label-en={item.labelEn}>
          {item.labelZh}
        </a>
      ))}
    </nav>

    <div class="site-nav-actions">
      <button type="button" class="site-lang-toggle" data-lang-toggle aria-pressed="false">
        <span data-lang-text>中 / EN</span>
      </button>
      <a class="site-nav-contact" href="#contact" data-label-zh="联系" data-label-en="Contact">
        联系
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const storedLang = localStorage.getItem('site-lang');
  let lang = storedLang === 'en' ? 'en' : 'zh';

  function syncLang({ emit = true } = {}) {
    root.dataset.lang = lang;
    root.lang = lang === 'en' ? 'en' : 'zh-CN';

    document.querySelectorAll('[data-lang-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(lang === 'en'));
    });

    document.querySelectorAll('[data-lang-text]').forEach((label) => {
      label.textContent = lang === 'en' ? 'EN / 中' : '中 / EN';
    });

    const translatables = document.querySelectorAll('[data-i18n-zh], [data-label-zh]');
    translatables.forEach((node) => {
      const nextLabel = lang === 'en'
        ? node.dataset.i18nEn ?? node.dataset.labelEn
        : node.dataset.i18nZh ?? node.dataset.labelZh;
      if (nextLabel) {
        node.textContent = nextLabel;
      }
    });

    document.querySelectorAll('[data-i18n-aria-zh]').forEach((node) => {
      const nextLabel = lang === 'en' ? node.dataset.i18nAriaEn : node.dataset.i18nAriaZh;
      if (nextLabel) {
        node.setAttribute('aria-label', nextLabel);
      }
    });

    document.querySelectorAll('[data-i18n-alt-zh]').forEach((node) => {
      const nextAlt = lang === 'en' ? node.dataset.i18nAltEn : node.dataset.i18nAltZh;
      if (nextAlt) {
        node.setAttribute('alt', nextAlt);
      }
    });

    localStorage.setItem('site-lang', lang);
    if (emit) {
      window.dispatchEvent(new CustomEvent('site-language-change', { detail: { lang } }));
    }
  }

  window.siteLanguage = {
    get: () => lang,
    set: (nextLang) => {
      lang = nextLang === 'en' ? 'en' : 'zh';
      syncLang();
    },
    sync: () => syncLang({ emit: false })
  };

  document.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-lang-toggle]') : null;
    if (!button) {
      return;
    }

    lang = lang === 'en' ? 'zh' : 'en';
    syncLang();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => syncLang(), { once: true });
  } else {
    syncLang();
  }
</script>
