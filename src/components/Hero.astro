---
const { site } = Astro.props;
const siteEn = site.translations?.en ?? {};
---

<section class="hero" id="top">
  <div class="hero-copy">
    <p class="eyebrow">{site.brand}</p>
    <h1 data-i18n-zh={site.name} data-i18n-en={siteEn.name}>{site.name}</h1>
    <p class="role" data-i18n-zh={site.role} data-i18n-en={siteEn.role}>{site.role}</p>
  </div>

  <section class="hero-about" id="about" aria-labelledby="about-title">
    <div class="hero-about-heading">
      <h2 id="about-title" class="eyebrow">About</h2>
    </div>
    <ul class="bullet-list hero-about-list">
      {site.aboutBullets.map((item, index) => (
        <li data-i18n-zh={item} data-i18n-en={siteEn.aboutBullets?.[index] ?? item}>{item}</li>
      ))}
    </ul>
  </section>

  <figure class="hero-photo">
    <img src={site.portrait.src} alt={site.portrait.alt} loading="eager" decoding="async" />
  </figure>
</section>
