---
const { project } = Astro.props;
---

<article class:list={['project-card', project.featured && 'featured']}>
  <button type="button" class="project-card-hitarea" data-project-trigger data-project-slug={project.slug}>
    <span class="sr-only">查看 {project.title} 项目详情</span>
  </button>
  <div class="project-card-inner">
    {project.image ? (
      <div class="project-card-media">
        <img src={project.image.src} alt={project.image.alt} class="project-card-image" loading="lazy" decoding="async" />
        {project.cardBadge ? <span class="project-card-badge">{project.cardBadge}</span> : null}
      </div>
    ) : null}

    <div class="project-card-body">
      <div class="project-card-meta">
        <p class="project-card-eyebrow">{project.cardEyebrow ?? project.role}</p>
        <span class="project-card-tag">{project.cardTag ?? project.period}</span>
      </div>

      <h3>{project.title}</h3>
      <p class="project-summary">{project.summary}</p>
    </div>
  </div>
</article>
