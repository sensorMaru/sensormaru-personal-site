---
const { items } = Astro.props;
---

<div class="timeline">
  {items.map((item) => (
    <article class="timeline-item">
      <div class="timeline-head">
        <div>
          <h3>{item.company ?? item.school}</h3>
          <p>{item.role ?? item.degree}</p>
        </div>
        <span>{item.period}</span>
      </div>

      {item.department ? <p class="timeline-note">{item.department}</p> : null}

      {item.bullets ? (
        <ul class="bullet-list">
          {item.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      ) : null}
    </article>
  ))}
</div>
